# HARVESTLINK AI Environment Configuration Template

# Application
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=change_this_to_a_secure_random_string_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (PostgreSQL + PostGIS)
POSTGRES_USER=harvestlink_user
POSTGRES_PASSWORD=harvestlink_password
POSTGRES_DB=harvestlink_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://harvestlink_user:harvestlink_password@localhost:5432/harvestlink_db

# API Service
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Next.js Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=HARVESTLINK AI

# Storage & File Uploads
UPLOAD_DIR=./data/demo/sample_images
MAX_UPLOAD_SIZE_BYTES=5242880

# Machine Learning
MODEL_WEIGHTS_PATH=./data/models/pineapple_mobilenet_v1.pt
INFERENCE_DEVICE=cpu
