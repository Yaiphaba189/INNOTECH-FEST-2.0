# ==============================================================================
# HARVESTLINK AI - Git Ignore Specification
# Predictive Crop Intelligence and Smart Market Linkage for Manipur
# ==============================================================================

# --- Operating System & Filesystem Metadata ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# --- Secrets, Credentials & Local Environments ---
.env
.env.local
.env.*.local
*.pem
*.key
*.cert
*.crt
*.pfx
id_rsa*

# --- Logs & Runtime State ---
*.log
logs/
.demo-logs/
dev_server.log
frontend/dev_server.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- Python & Virtual Environments ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Preserve frontend/src/lib if /lib/ wildcard is used
/lib/
/lib64/
!frontend/src/lib/

# --- Databases & Local Storage ---
*.db
*.db-journal
*.db-wal
*.db.bak
*.sqlite
*.sqlite3
harvestlink.db
harvestlink.db.bak

# --- Node.js & Next.js Frontend ---
frontend/node_modules/
node_modules/
frontend/.next/
.next/
frontend/out/
out/
.turbo/
frontend/tsconfig.tsbuildinfo
*.tsbuildinfo

# --- Testing & Browser Automation ---
.playwright-mcp/
playwright-report/
test-results/

# --- IDEs & Code Editors ---
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# --- Machine Learning Artifacts & Checkpoints ---
*.h5
*.tflite
*.onnx
*.ckpt
checkpoints/

# Explicitly track lightweight production models and metadata
!data/models/.gitkeep
!data/models/*.json
!data/models/disease_mobilenetv3_*.pt
!intelligence_layer/module_a_disease/models/.gitkeep

# Curated raw public training images are generated via scripts/prepare_public_datasets.py
# Keep raw bulk training images ignored while tracking provenance manifests
data/training/**/*.jpg
data/training/**/*.jpeg
data/training/**/*.png
